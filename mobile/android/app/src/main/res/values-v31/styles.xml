<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the app icon on the brand colour. The animated PictoIQ wordmark follows in the app (features/splash). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/pictoiq_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
